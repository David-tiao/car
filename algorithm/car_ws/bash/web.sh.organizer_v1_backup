#!/usr/bin/env bash
# Generated by organize_car_workspace.py. Read-only organization/launch helper.
set -Eeuo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
WS="$(cd -- "$HERE/.." && pwd -P)"
SITE="$WS/src/car_web_sim/site"
CMD="${1:-doctor}"
if (( $# > 0 )); then shift; fi

source_ros() {
  if [[ ! -f /opt/ros/humble/setup.bash ]]; then
    echo '[ERROR] ROS2 Humble /opt/ros/humble/setup.bash 不存在' >&2; return 2
  fi
  # ROS 2 setup files may refer to unset variables.
  set +u
  source /opt/ros/humble/setup.bash
  [[ ! -f "$WS/install/setup.bash" ]] || source "$WS/install/setup.bash"
  set -u
}

case "$CMD" in
  sim|site)
    # Existing webpage; uses its original internal simulation. No ROS2 needed.
    [[ -f "$SITE/launcher.py" ]] || { echo "[ERROR] missing $SITE/launcher.py" >&2; exit 2; }
    exec /usr/bin/python3 "$SITE/launcher.py" "$@"
    ;;
  test)
    # Mock UART -> ROS2 only. Deliberately does NOT publish mock /odom into
    # the website's real-only /api/telemetry endpoint.
    source_ros
    echo '[TEST] CAR-LINK mock -> ROS2 (read-only).'
    echo '[TEST] 当前测试集与网页真实数据入口尚未隔离，暂不自动转发模拟数据到 /api/telemetry。'
    exec ros2 launch car_serial_link offline_serial_demo.launch.xml "$@"
    ;;
  real)
    # Existing read-only visualization bridge, never sends motor commands.
    source_ros
    if ros2 node list -a 2>/dev/null | grep -Eq '(^|/)car_serial_mock_mcu($|[[:space:]])'; then
      echo '[ERROR] 发现 car_serial_mock_mcu：拒绝把测试里程计接入实车网页接口。请先停止模拟器。' >&2
      exit 3
    fi
    echo '[REAL] 只读 ROS2 -> Sim2Real 网页桥接；请自行确认话题来自真实硬件。'
    echo '[REAL] 本脚本不会验证所有外部发布者的硬件真实性，不会发送 /cmd_vel。'
    exec /usr/bin/python3 "$SITE/ros2_visualization_bridge.py" \
      --plan /car/navigation/preview_path \
      --road-path /competition/mission_road_path "$@"
    ;;
  build)
    [[ -f /opt/ros/humble/setup.bash ]] || { echo '[ERROR] missing ROS2 Humble' >&2; exit 2; }
    set +u
    source /opt/ros/humble/setup.bash
    set -u
    cd "$WS"
    exec colcon build --packages-up-to car_web_test car_web_real car_web_sim "$@"
    ;;
  tree)
    printf 'Workspace: %s\n' "$WS"
    echo '=== ROS2 packages (top-level) ==='
    find "$WS/src" -mindepth 2 -maxdepth 2 -name package.xml -printf '%h\n' | sort
    echo '=== Web site (physical home) ==='
    printf '%s\n' "$SITE"
    echo '=== Compatible old site path ==='
    ls -ld "$WS/../../sim2real"
    ;;
  doctor)
    echo '=== Car workspace + web structure ==='
    [[ -f "$SITE/server.py" && -f "$SITE/web/index.html" ]] || { echo '[FAIL] 网页实体文件缺失'; exit 1; }
    echo '[PASS] 现有 Sim2Real 网页完整'
    if [[ -L "$WS/../../sim2real" && "$(readlink -f "$WS/../../sim2real")" == "$(readlink -f "$SITE")" ]]; then
      echo '[PASS] 旧路径 sim2real/ 指向新网页目录'
    else
      echo '[FAIL] 旧路径兼容软链接异常'; exit 1
    fi
    for n in car_web_test car_web_real car_web_sim; do
      [[ -f "$WS/src/$n/package.xml" ]] || { echo "[FAIL] 缺少 ROS2 包 $n"; exit 1; }
      echo "[PASS] $n"
    done
    [[ -f "$WS/src/car_web_keyboard/COLCON_IGNORE" ]] && echo '[PASS] 键盘映射仅预留，不参与编译'
    echo '提示：本检查不代表实车串口、硬件、ROS2 数据已接通。'
    ;;
  *)
    echo '用法: bash car_ws/bash/web.sh {sim|test|real|build|doctor|tree} [参数...]' >&2
    exit 2
    ;;
esac
