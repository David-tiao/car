<?xml version="1.0"?>
<package format="3">
  <name>car_debug</name>
  <version>0.2.0</version>
  <description>Read-only C++ ROS2 diagnostic monitor and path visualization for car ULog43 streams.</description>
  <maintainer email="car@example.invalid">Car ROS2 project</maintainer>
