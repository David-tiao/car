Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.2
      Plane: XY
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Competition Physical Map
      Alpha: 0.85
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Keepout Mask (turn on to inspect)
      Alpha: 0.55
      Topic:
        Value: /car/navigation/keepout_mask
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: A* Preview (not cmd_vel)
      Color: 0; 200; 255
      Line Style: Lines
      Line Width: 0.025
      Topic:
        Value: /car/navigation/preview_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: Scan (requires calibrated TF)
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 230
      Target Frame: <Fixed Frame>
