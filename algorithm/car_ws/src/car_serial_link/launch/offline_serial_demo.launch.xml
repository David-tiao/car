<launch>
  <!-- Offboard simulation: generated bytes travel via a Linux pseudo-terminal. -->
  <arg name="port" default="/tmp/car_link_demo_uart"/>
  <arg name="with_debug" default="true"/>
  <node pkg="car_serial_link" exec="car_serial_mock_mcu"
        name="car_serial_mock_mcu" output="screen">
    <param name="port_link" value="$(var port)"/>
  </node>
  <node pkg="car_serial_link" exec="car_serial_bridge"
        name="car_serial_bridge" output="screen">
    <param name="port" value="$(var port)"/>
  </node>
  <node pkg="car_debug" exec="car_data_monitor" name="car_data_monitor"
        output="screen" if="$(var with_debug)"/>
</launch>
