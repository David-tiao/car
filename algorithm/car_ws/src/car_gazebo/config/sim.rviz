Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.2
      Plane: XY
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Physical map
      Alpha: 0.85
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Rules keepout
      Alpha: 0.32
      Topic:
        Value: /keepout_filter_mask
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: DWB local costmap
      Alpha: 0.55
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: SIM URDF model
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Gazebo GPU lidar
      Style: Points
      Size (m): 0.015
      Color: 255; 70; 70
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Locked obstacles
      Topic:
        Value: /competition/locked_obstacle_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Road topology
      Topic:
        Value: /competition/road_graph
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Confirmed road route
      Color: 0; 200; 255
      Line Style: Lines
      Topic:
        Value: /competition/locked_road_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: SIM TF
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Target Frame: <Fixed Frame>
      Scale: 190
      X: 1.2
      Y: 1.2
